#!/bin/bash
#
# Start, stop and inspect Open WebUI, the browser chat front end for the gufo server on this machine.
#
#     open-webui-serve start [--lan]   start in the background, wait until it answers, print the URL
#     open-webui-serve stop            stop it (accounts, chats and settings stay in the volume)
#     open-webui-serve status          running or not
#     open-webui-serve logs [-f]       the server log (podman logs)
#
# Without --lan it listens on 127.0.0.1 only; with --lan, on all interfaces, so other machines can open
# http://<this machine>:3000. Open WebUI has its own logins (the first account created is the admin), but
# the gufo server behind it has none: see gufo-serve.
#
# All state lives in the podman volume `open-webui`, so upgrading means changing OWUI_IMAGE below.
# That includes the session signing key: by default Open WebUI writes it to its working directory,
# outside the volume, and a fresh container would generate a new one and log everyone out.

set -u

OWUI_IMAGE="${OWUI_IMAGE:-ghcr.io/open-webui/open-webui:v0.13.3}"
OWUI_PORT="${OWUI_PORT:-3000}"
GUFO_URL="${GUFO_URL:-http://127.0.0.1:8080/v1}"
NAME=open-webui

# The container's state, or nothing if there is no container: running, created, exited, stopping, ...
# `podman ps` lists running containers only, so a container stuck in another state would hold the
# name invisibly.
state() {
    podman container inspect --format '{{.State.Status}}' "$NAME" 2>/dev/null
}

running() {
    [ "$(state)" = running ]
}

# Stop and remove the container, whatever state it is in. No --rm on `podman run`, so that a
# container that died during startup keeps its logs until this runs.
remove() {
    podman stop -t 15 "$NAME" >/dev/null 2>&1 || true
    podman rm -f "$NAME" >/dev/null 2>&1 || true
}

# Seconds since boot. A monotonic clock: bash's $SECONDS follows the wall clock, and a clock jump
# right after boot (network time sync) once made gufo-serve's wait give up at once.
now() {
    cut -d. -f1 /proc/uptime
}

start() {
    local host=127.0.0.1
    if [ "${1:-}" = "--lan" ]; then
        host=0.0.0.0
    elif [ -n "${1:-}" ]; then
        echo "open-webui-serve: unknown option '$1'" >&2
        exit 2
    fi
    local st
    st=$(state)
    if [ "$st" = running ]; then
        echo "open-webui-serve: already running; 'open-webui-serve stop' first" >&2
        exit 1
    elif [ -n "$st" ]; then
        echo "open-webui-serve: removing a leftover container (state: $st)"
        remove
    fi
    if ! curl -sf "$GUFO_URL/models" >/dev/null 2>&1; then
        echo "open-webui-serve: note: gufo does not answer at $GUFO_URL; the UI will start, but list no model until it does"
    fi
    # Ctrl+C while waiting for startup stops and removes the container rather than leaving it half-started.
    trap 'echo; echo "open-webui-serve: interrupted; stopping the container" >&2; remove; exit 130' INT TERM
    # The key in OPENAI_API_KEY is a placeholder: gufo takes no key, but Open WebUI wants a non-empty one.
    podman run -d --name "$NAME" --network host \
        -v open-webui:/app/backend/data \
        -e HOST="$host" -e PORT="$OWUI_PORT" \
        -e WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key \
        -e OPENAI_API_BASE_URL="$GUFO_URL" -e OPENAI_API_KEY=none \
        -e ENABLE_OLLAMA_API=false \
        "$OWUI_IMAGE" >/dev/null || exit 1

    echo "open-webui-serve: starting..."
    local t0
    t0=$(now)
    while (( $(now) - t0 < 300 )); do
        if curl -sf "http://127.0.0.1:$OWUI_PORT/health" >/dev/null 2>&1; then
            trap - INT TERM
            echo "open-webui-serve: ready after $(( $(now) - t0 )) s"
            if [ "$host" = 0.0.0.0 ]; then
                echo "  http://$(hostname):$OWUI_PORT  (all interfaces)"
            else
                echo "  http://127.0.0.1:$OWUI_PORT  (this machine only)"
            fi
            return 0
        fi
        if ! running; then
            trap - INT TERM
            echo "open-webui-serve: the container stopped during startup (state: $(state)); its last log lines:" >&2
            podman logs --tail 20 "$NAME" 2>&1 >&2 || true
            exit 1
        fi
        sleep 2
    done
    trap - INT TERM
    echo "open-webui-serve: no answer after 300 s; the container is still there, see 'open-webui-serve logs'" >&2
    exit 1
}

stop() {
    local st
    st=$(state)
    if [ -z "$st" ]; then
        echo "open-webui-serve: not running"
    else
        remove
        if [ -z "$(state)" ]; then
            echo "open-webui-serve: stopped"
        else
            echo "open-webui-serve: the container is still there (state: $(state)); try 'podman rm -f $NAME'" >&2
            exit 1
        fi
    fi
}

case "${1:-}" in
    start)  shift; start "$@" ;;
    stop)   stop ;;
    status) case "$(state)" in
                running) echo "open-webui-serve: running" ;;
                "")      echo "open-webui-serve: not running" ;;
                *)       echo "open-webui-serve: not running (container left in state: $(state); 'open-webui-serve stop' clears it)" ;;
            esac ;;
    logs)   shift; podman logs "$@" "$NAME" ;;
    *)      sed -n '3,8s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
