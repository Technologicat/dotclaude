#!/usr/bin/env bash
#
# cc-toast — put one desktop toast on the screen from Claude Code, replacing the previous one.
#
# For announcing that the agent is about to take the keyboard: a window that maps steals focus from
# whatever the human is typing into, and the terminal message alone only reaches them if this session's
# window is the one on screen. See "Live GUI testing on a shared desktop" in CLAUDE.md.
#
#   cc-toast "taking keyboard focus for a few seconds"
#   cc-toast --clear      # take it off the screen again
#
# Measured on Cinnamon's notification server (GNOME spec 1.2), 2026-08-21, because every one of these is
# the kind of thing a person would otherwise assume:
#
#   - **A critical toast never expires**, and `-t` does not change that — the spec says a critical
#     notification waits to be seen, and the server obeys. That is the property we want (an announcement
#     nobody saw is not an announcement) and the reason a dozen of them can pile up over a lunch break,
#     which is what this script exists to prevent.
#   - **Dropping to `-u normal` is not the fix**: it expires, but Cinnamon then files it in the systray
#     notification widget, so the pile moves rather than going away — and the warning gets quieter at the
#     same time.
#   - **Replacing in place** leaves exactly one toast on the screen however many are sent.
#   - **Replacing an id the human already dismissed is safe**: the server issues a *new* id and shows the
#     toast. It cannot swallow the next warning, which is the failure that would matter here, since it
#     would be silent.
#
# The notification goes out over D-Bus rather than through `notify-send`, because the two options this
# needs — print the new id, and replace an existing one — are `notify-send` 0.8 features. Mint 21.3 ships
# 0.7.9, where `-p` is rejected outright with "Unknown option -p" and the toast never appears: a silent
# failure of exactly the warning that exists to not be silent. The `Notify` method itself has taken the
# same eight arguments since the spec's 1.0 and hands back the id as its return value, so one code path
# covers every version instead of branching on what the local `notify-send` happens to support.
#
# Two details of that call are easy to get wrong, and were:
#
#   - **`expire_timeout` is 0, not -1.** Both are right for a critical toast (0 is "never expire", -1 is
#     "server decides", and the server never expires a critical one), but `gdbus` reads a leading `-` as
#     the start of an option and rejects the whole invocation.
#   - **The reply is `(uint32 15,)`,** so a naive "first run of digits" match extracts *32*, out of the
#     type name. Replacing a nonexistent id is silent — the server just issues a new one — so the bug
#     shows up only as toasts quietly piling up again.
#
# The `app_icon` argument takes a path as readily as an icon-theme name, and Cinnamon renders an SVG from
# one (GdkPixbuf carries an SVG loader). Without it the server picks the icon for the urgency level, which
# for critical is a "no entry" road sign — right for a disk filling up, wrong for "I am about to type".
#
set -uo pipefail

STATE="${XDG_RUNTIME_DIR:-/tmp}/claude-code-toast.$(id -u).id"  # SC2155: split, so `id -u` can fail loudly
readonly STATE
readonly SUMMARY="Claude Code"

# The icon lives beside this script, which is reached through a symlink on PATH — hence the `readlink -f`
# rather than a bare `dirname "$0"`. If it has gone missing the toast still goes out with the server's
# default icon: a warning with the wrong picture on it is worth far more than no warning.
ICON="$(dirname -- "$(readlink -f -- "$0")")/cc-toast.svg"
[ -r "$ICON" ] || ICON=""
readonly ICON

close_previous() {
    [ -s "$STATE" ] || return 0
    gdbus call --session \
          --dest org.freedesktop.Notifications \
          --object-path /org/freedesktop/Notifications \
          --method org.freedesktop.Notifications.CloseNotification "$(cat "$STATE")" >/dev/null 2>&1
    rm -f "$STATE"
}

notify() {  # $1 = id to replace (0 for a new one), $2 = body; prints the id the server assigned
    gdbus call --session \
          --dest org.freedesktop.Notifications \
          --object-path /org/freedesktop/Notifications \
          --method org.freedesktop.Notifications.Notify \
          "$SUMMARY" "$1" "$ICON" "$SUMMARY" "$2" "[]" "{'urgency': <byte 2>}" 0 2>/dev/null \
        | sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p'
}

if ! command -v gdbus >/dev/null 2>&1; then
    # Loudly, and non-zero: a silent failure here means the human was never warned, which is the whole job.
    echo "cc-toast: gdbus not found — the desktop announcement did NOT happen." >&2
    exit 1
fi

case "${1-}" in
    --clear)
        close_previous
        exit 0
        ;;
    "")
        echo "usage: cc-toast <message> | cc-toast --clear" >&2
        exit 2
        ;;
esac

previous="0"
[ -s "$STATE" ] && previous="$(cat "$STATE")"

id=$(notify "$previous" "$*")

if [ -z "${id:-}" ]; then
    echo "cc-toast: the notification server returned no id — the toast may not have appeared." >&2
    exit 1
fi
printf '%s' "$id" >"$STATE"
