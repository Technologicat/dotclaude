#!/usr/bin/env bash
# Wait for a commit's CI run to finish, then report it job by job.
#
# Why this exists: the shell for it had grown to a guard, a poll loop and a report step, and lived as a
# snippet in CLAUDE.md. The workflows were renamed to `CI` on 2026-08-18 and the snippet still said `Tests`
# the next morning — renaming workflows means editing `.github/workflows/`, and no sweep over that comes
# anywhere near a fenced block in a Markdown file. A `select(...)` that matches nothing returns null
# forever, so the watcher polled a run that could never satisfy it, which is indistinguishable from a slow
# one. The same hazard as `pgrep -f` matching its own shell.
#
# So the three things it guarantees, none of which a retyped snippet did:
#
#   - it never waits forever (--timeout, and it says so when it gives up),
#   - it never waits on a name that matches nothing (it checks first, and prints the names that exist),
#   - it says something on every poll, so silence means "not running" rather than "maybe working".
#
# Selecting the run by *workflow name* is the point of it. These repos run more than one workflow per push
# — `CI` and `Coverage` at least, plus Dependabot's own — so "the newest run for this SHA" can hand back a
# green Coverage while the matrix is still going. That false green costs nothing on an ordinary push and
# costs a burnt version number before a release tag, since a tag run that fails never publishes.
#
# A tag run needs --branch, not --sha. `git push origin v2.8.0` starts a run whose headSha is the tagged
# commit — the same SHA as the branch run that already passed, so selecting by SHA matches both. (Measured
# on pyan v2.8.0: runs 32469143360 ref=v2.8.0 and 32468935149 ref=master, both on 3df44ca.)
#
# Ordinarily `[0]` still picks the tag run, since it is the newer of the two. What it cannot survive is the
# branch run becoming the newer one — a manual re-run of the branch workflow after tagging is enough — and
# then it reports a green that is not the run about to publish, in the one place this script exists to stop
# that. Selecting by ref cannot get it wrong in the first place.
#
# The failure actually hit was blunter: a tag *name* passed to --sha never matches a headSha, so the wait
# ran until it timed out. That is now rejected at the door.
#
# GitHub reports a tag run with headBranch set to the tag name, so --branch v2.8.0 names it exactly.
#
# Usage:
#     ci-watch                          # the CI run for HEAD, in the current repo
#     ci-watch --sha abc1234            # ...for another commit
#     ci-watch --branch v2.8.0          # ...for a tag or branch (use this for release tags)
#     ci-watch --workflow Coverage      # ...another workflow
#     ci-watch --repo OWNER/REPO        # ...another repo
#     ci-watch --timeout 3600           # give up later than the default 30 minutes
#
# Exits 0 when the run succeeded, 1 when it failed or the wait timed out.
#
# Deploy by symlinking onto PATH, so this stays the single copy:
#
#     ln -s ~/.claude/scripts/ci-watch ~/.local/bin/ci-watch

set -uo pipefail

WORKFLOW=CI
SHA=""
BRANCH=""
REPO=""
# Ten minutes. Measured 2026-08-19 over the last 20 completed runs in `raven`: `CI` takes 2–4 minutes and
# `Coverage` 1–2, so this is about 2.5x the worst observed. The headroom is for the queue rather than the
# run — the clock starts when this is invoked, which can be before a runner picks the job up.
#
# Erring long on purpose. Giving up exits 1, which any caller reads as a failed build, so a timeout that
# trips on a merely slow run manufactures a red that is not there. Waiting too long only delays the news.
TIMEOUT=600
POLL=30

while [ $# -gt 0 ]; do
    case "$1" in
        --workflow) WORKFLOW="$2"; shift 2 ;;
        --sha) SHA="$2"; shift 2 ;;
        --branch|--ref|--tag) BRANCH="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --poll) POLL="$2"; shift 2 ;;
        # Print the whole header block, however long it grows. A hardcoded line range goes stale the
        # first time anyone adds a paragraph — which is what happened when --branch was documented.
        -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
        *) echo "ci-watch: unknown option '$1'" >&2; exit 2 ;;
    esac
done

REPO_ARGS=()
[ -n "$REPO" ] && REPO_ARGS=(--repo "$REPO")

# A ref names the run on its own, so don't also pin a SHA: the tag run and the branch run share one.
if [ -z "$SHA" ] && [ -z "$BRANCH" ]; then
    SHA=$(git rev-parse HEAD 2>/dev/null) || { echo "ci-watch: not in a git repository, and no --sha or --branch given" >&2; exit 2; }
fi

# A tag name in --sha can never match a headSha, so the wait would never end — the failure this whole
# script exists to rule out. Catch it at the door and point at the option that does work.
if [ -n "$SHA" ] && ! printf '%s' "$SHA" | grep -qiE '^[0-9a-f]{4,40}$'; then
    echo "ci-watch: '--sha $SHA' is not a commit SHA. For a tag or branch use '--branch $SHA'." >&2
    exit 2
fi

SHORT=${SHA:0:7}
TARGET=${BRANCH:-$SHORT}
[ -n "$BRANCH" ] && [ -n "$SHA" ] && TARGET="$BRANCH@$SHORT"

BRANCH_ARGS=()
[ -n "$BRANCH" ] && BRANCH_ARGS=(--branch "$BRANCH")

runs() { gh run list -L 30 "${REPO_ARGS[@]}" "${BRANCH_ARGS[@]}" --json headSha,status,conclusion,name,databaseId "$@"; }

# The name has to exist among recent runs, or the wait below can never end.
NAMES=$(runs --jq '[.[].name] | unique | .[]' 2>/dev/null) || { echo "ci-watch: could not list runs (is gh authenticated?)" >&2; exit 2; }
if ! printf '%s\n' "$NAMES" | grep -qx "$WORKFLOW"; then
    echo "ci-watch: no workflow named '$WORKFLOW' among recent runs. These exist:" >&2
    printf '%s\n' "$NAMES" | sed 's/^/  /' >&2
    exit 2
fi

echo "ci-watch: waiting for '$WORKFLOW' on $TARGET (timeout ${TIMEOUT}s, polling every ${POLL}s)"

# `gh run list --branch` has already narrowed to the ref when one was given, so only pin the SHA when it
# is doing the selecting. Pinning both is harmless but says the same thing twice.
if [ -n "$SHA" ]; then
    SELECT='[.[] | select(.headSha[0:7]=="'"$SHORT"'" and .name=="'"$WORKFLOW"'")][0]'
else
    SELECT='[.[] | select(.name=="'"$WORKFLOW"'")][0]'
fi
WAITED=0
while :; do
    STATUS=$(runs --jq "$SELECT.status")
    case "$STATUS" in
        completed) break ;;
        null|"") NOTE="no run yet" ;;
        *) NOTE="$STATUS" ;;
    esac
    if [ "$WAITED" -ge "$TIMEOUT" ]; then
        echo "ci-watch: gave up after ${WAITED}s; '$WORKFLOW' on $TARGET is '$NOTE'." >&2
        echo "ci-watch: it may still be running — check https://github.com/$(gh repo view "${REPO_ARGS[@]}" --json nameWithOwner --jq .nameWithOwner)/actions" >&2
        exit 1
    fi
    echo "  ${WAITED}s: $NOTE"
    sleep "$POLL"
    WAITED=$((WAITED + POLL))
done

ID=$(runs --jq "$SELECT.databaseId")
gh run view "$ID" "${REPO_ARGS[@]}" --json conclusion,jobs \
    --jq '"RUN: \(.conclusion)", (.jobs[] | "  \(.conclusion)  \(.name)")'

CONCLUSION=$(gh run view "$ID" "${REPO_ARGS[@]}" --json conclusion --jq .conclusion)
[ "$CONCLUSION" = "success" ]
